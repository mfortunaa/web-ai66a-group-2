# Docker Compose only. Native Python setup still uses backend/.env.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
EVENTY_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
EVENTY_HTTP_PORT=8080
EVENTY_MAIL_PORT=8025
# Optional. Override the local demo admin password at account creation.
# Set an empty value to skip creating the account.
# EVENTY_DEMO_ADMIN_PASSWORD=
