# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./eventy.db
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Local SMTP capture (Mailpit). Match FRONTEND_URL to the browser origin.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=noreply@eventy.local
FRONTEND_URL=http://localhost:8000
